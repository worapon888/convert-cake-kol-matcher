# =============================================================================
# Convert Cake KOL Matcher — Environment Configuration Template
# Copy this file to `.env.local` and fill in your credentials.
# Never commit `.env.local` or real API keys to version control.
# =============================================================================

# [Required for Live AI Brand Analysis — Step 3]
# Server-side OpenAI API Key used by the official `openai` SDK (Responses API + Structured Outputs)
OPENAI_API_KEY=your_openai_api_key_here

# [Optional — OpenAI Model supporting Structured Outputs]
# Recommended models: "gpt-4o-mini" (default), "gpt-4.1-mini", or "gpt-4o"
OPENAI_MODEL=gpt-4o-mini

# [Optional — Guarded Apify TikTok Scraper Token]
# Apify API Token for fetching existing datasets from `clockworks/tiktok-scraper`
APIFY_API_TOKEN=your_apify_api_token_here

# [Optional — Fixture Mode Toggle]
# Set to "true" to use deterministic local fixtures without paid external runs
NEXT_PUBLIC_USE_FIXTURES=true
