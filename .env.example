# [Required for Live AI Analysis — TODO: Integration Pending]
# Anthropic API Key for Claude brand analysis and KOL semantic matching
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# [Required for Live TikTok Scraping — TODO: Integration Pending]
# Apify API Token for TikTok profile and video metadata discovery
APIFY_API_TOKEN=your_apify_api_token_here

# [Optional — Planned Configuration Flags (TODO)]
# Set to "true" to use deterministic local Thai TikTok KOL fixtures instead of live Apify calls
NEXT_PUBLIC_USE_FIXTURES=true
